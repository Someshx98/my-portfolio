# ==============================================================================
# SOMESH PORTFOLIO - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GITHUB INTEGRATION (Recommended for Production)
# ------------------------------------------------------------------------------
# GITHUB_TOKEN: GitHub Personal Access Token (classic or fine-grained).
# Purpose: Increases GitHub REST API rate limit from 60 requests/hour to 5,000 req/hr.
# Scope required: public_repo (or read:user, or no scopes required for public data).
# Note: DO NOT prefix with VITE_ to keep this token confidential on the server/serverless layer.
# Where to configure in Vercel: Project Settings -> Environment Variables -> Key: GITHUB_TOKEN
# Local development: Place in your local .env file.
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 2. LOCAL RUNTIME & PORT (Development)
# ------------------------------------------------------------------------------
# PORT: Local Express server listening port (defaults to 3000 if not specified).
PORT="3000"

# NODE_ENV: Runtime environment ('development' | 'production').
# Automatically configured as 'production' by Vercel upon deployment.
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. OPTIONAL AI & APPLICATION METADATA
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Optional Gemini API key for AI assistant features or terminal simulations.
GEMINI_API_KEY=""

# APP_URL: Canonical URL where the portfolio is hosted (e.g. https://someshbehera.in).
APP_URL="https://someshbehera.in"
